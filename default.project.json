{
  "name": "Brainrot Blitz",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "BlitzServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMinZoomDistance": 7, "CameraMaxZoomDistance": 45 },
      "StarterPlayerScripts": {
        "BlitzClient": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true, "Gravity": 196.2 }
    },
    "Lighting": {
      "$properties": { "ClockTime": 10.5, "Brightness": 3.5 }
    },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
